# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-app.railway.app
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ─── API ──────────────────────────────────────────────────────────────────────
# Usado no servidor (SSR/API routes)
API_URL=https://your-api.railway.app
# Usado no browser (client components)
NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ─── Email (Resend) — usado na waitlist/notificações ──────────────────────────
RESEND_API_KEY=re_your-resend-api-key
WAITLIST_NOTIFY_EMAIL=seu@email.com

# --- Sentry ---
# NEXT_PUBLIC_SENTRY_DSN=https://key@sentry.io/project
# SENTRY_AUTH_TOKEN=sntrys_xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=capi-web

# --- PostHog ---
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# URL pública do site (Open Graph, links absolutos)
NEXT_PUBLIC_SITE_URL=https://your-app.railway.app
