{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @turismo/web build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @turismo/web start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
