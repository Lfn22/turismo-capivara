# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-frontend.railway.app

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=production
APP_URL=https://your-api.railway.app

# ─── MercadoPago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# ─── Cloudflare R2 (uploads) ──────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# ─── LGPD / Segurança ─────────────────────────────────────────────────────────
# CPF é armazenado como HMAC-SHA256, nunca em plaintext
CPF_SECRET=your-cpf-encryption-secret-min-32-chars
ANONYMIZATION_SALT=your-anonymization-salt-min-32-chars

# ─── Bookings ─────────────────────────────────────────────────────────────────
# Tempo em minutos antes de uma reserva pendente expirar (padrão: 30)
BOOKING_EXPIRY_MINUTES=30

# ─── Monitoramento (opcional — app funciona sem isso) ─────────────────────────
SENTRY_DSN=https://your-key@sentry.io/your-project-id
