# === OBRIGATÓRIAS (bloqueiam startup sem elas) ===

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://turismo:turismo123@localhost:5432/turismo_dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Use: openssl rand -hex 16
JWT_SECRET=your-jwt-secret-minimum-32-characters-here

# ─── MercadoPago ──────────────────────────────────────────────────────────────
# https://www.mercadopago.com/developers/panel/credentials
MP_ACCESS_TOKEN=TEST-your-mercado-pago-access-token
MP_WEBHOOK_SECRET=your-webhook-secret

# ─── LGPD / Segurança ─────────────────────────────────────────────────────────
# CPF é armazenado como HMAC-SHA256, nunca em plaintext. Mínimo 32 caracteres
CPF_SECRET=your-cpf-hash-secret
ANONYMIZATION_SALT=your-anonymization-salt

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# https://dash.cloudflare.com/?to=/:account/r2/overview
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
R2_BUCKET_NAME=capi-uploads
R2_PUBLIC_URL=https://your-r2-domain.dev

# === Opcionais (possuem defaults sensatos para dev) ===

# ─── URLs da Aplicação ────────────────────────────────────────────────────────
# Default: http://localhost:3333
APP_URL=http://localhost:3333
# Default: http://localhost:3000
WEB_URL=http://localhost:3000
# Obrigatório em produção. Default: vazio (permite qualquer origem em dev)
CORS_ORIGIN=http://localhost:3000

# ─── Environment & Logging ────────────────────────────────────────────────────
# Valores: development | production | test. Default: development
NODE_ENV=development
# Valores: debug | info | warn | error. Default: info
LOG_LEVEL=debug

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com/api-keys — deixe em branco para desabilitar emails
RESEND_API_KEY=
EMAIL_FROM=CAPI <noreply@capi.turismo>

# ─── Bookings ─────────────────────────────────────────────────────────────────
# Tempo em minutos antes de uma reserva pendente expirar. Default: 30
BOOKING_EXPIRY_MINUTES=30

# === OpenTelemetry (opcional — app funciona sem) ===
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(instanceId:token)
# OTEL_SERVICE_NAME=capi-api (Default: capi-api)

# === Sentry (opcional — app funciona sem) ===
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
