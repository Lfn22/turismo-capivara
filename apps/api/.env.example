# Banco de dados
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT
JWT_SECRET="seu-secret-forte-aqui-minimo-32-caracteres"

# LGPD — CPF é armazenado como HMAC-SHA256, nunca em plaintext
CPF_SECRET="<random-secret-minimo-32-chars>"

# Ambiente
NODE_ENV="production"

# Sentry error monitoring (optional — app runs without it)
SENTRY_DSN=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Email notifications (Resend)
RESEND_API_KEY=

# Booking expiry (minutes after creation before PENDING booking is auto-expired)
BOOKING_EXPIRY_MINUTES=30
