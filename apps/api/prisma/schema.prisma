generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  tourPackages TourPackage[]
}

model User {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  email           String
  password        String
  role            Role
  cpf             String?   @unique
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  guideProfile GuideProfile?
  tourPackages TourPackage[] @relation("ConductorPackages")

  @@unique([email, tenantId])
}

model GuideProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  photoUrl        String?
  especialidades  String[]
  regioes         String[]
  portfolioPhotos String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TourPackage {
  id          String   @id @default(cuid())
  tenantId    String
  conductorId  String?
  name        String
  description String
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  capacity    Int
  difficulty  Difficulty
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  conductor      User?           @relation("ConductorPackages", fields: [conductorId], references: [id])
  departureSlots DepartureSlot[]
}

model DepartureSlot {
  id          String     @id @default(cuid())
  packageId   String
  startsAt    DateTime
  capacity    Int
  minCapacity  Int        @default(1)
  booked      Int        @default(0)
  status      SlotStatus @default(OPEN)
  createdAt   DateTime   @default(now())

  package  TourPackage @relation(fields: [packageId], references: [id])
  bookings Booking[]

  @@index([packageId, startsAt])
}

model Booking {
  id         String        @id @default(cuid())
  tenantId   String
  slotId     String
  customerName  String
  customerEmail String
  customerPhone String
  pax        Int
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  slot    DepartureSlot @relation(fields: [slotId], references: [id])
  voucher Voucher?
}

model Voucher {
  id        String   @id @default(cuid())
  bookingId String   @unique
  code      String   @unique
  pdfUrl    String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum Role {
  ADMIN
  ATENDENTE
  CONDUTOR
  CLIENTE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}