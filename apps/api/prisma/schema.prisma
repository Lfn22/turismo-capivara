generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Destination {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  subtitle             String?
  description          String
  heroImageUrl         String?
  heroImageBlurDataUrl String?
  photos               String[]
  tagline              String?
  state                String
  lat                  Float?   // latitude para widget de mapa
  lng                  Float?   // longitude para widget de mapa
  highlights           String[]
  active               Boolean        @default(true)
  approvalStatus       ApprovalStatus @default(PENDING)
  rejectionReason      String?
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenants     Tenant[]
  createdBy   User?    @relation("DestinationCreator", fields: [createdById], references: [id])
}

model Tenant {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  cnpj            String?
  destinationId   String?
  approvalStatus  TenantApprovalStatus @default(PENDING)
  rejectionReason String?
  whatsapp        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  destination  Destination?  @relation(fields: [destinationId], references: [id])
  users        User[]
  tourPackages TourPackage[]
  bookings     Booking[]

  @@index([destinationId])
}

model User {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  email           String
  password        String
  role            Role
  cpf             String?        @unique
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  guideProfile        GuideProfile?
  tourPackages        TourPackage[]        @relation("ConductorPackages")
  passwordResetTokens PasswordResetToken[]
  destinations        Destination[]        @relation("DestinationCreator")

  @@unique([tenantId, email])
}

model GuideProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  photoUrl        String?
  especialidades  String[]
  regioes         String[]
  portfolioPhotos String[]
  cadastur        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  packageGuides  PackageGuide[]
  departureSlots DepartureSlot[]
  testimonials   Testimonial[]
}

model TourPackage {
  id          String   @id @default(cuid())
  tenantId    String
  conductorId  String?
  name        String
  description String
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  capacity    Int
  difficulty  Difficulty
  photos      String[] @default([])
  highlights  String[] @default([])
  active           Boolean  @default(true)
  durationMinHours Int?
  durationMaxHours Int?
  bufferMinutes    Int      @default(60)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  conductor      User?           @relation("ConductorPackages", fields: [conductorId], references: [id])
  departureSlots DepartureSlot[]
  packageGuides  PackageGuide[]
}

model DepartureSlot {
  id          String     @id @default(cuid())
  packageId   String
  guideId     String?
  startsAt    DateTime
  capacity    Int
  minCapacity  Int        @default(1)
  booked      Int        @default(0)
  status      SlotStatus @default(OPEN)
  createdAt   DateTime   @default(now())

  package  TourPackage   @relation(fields: [packageId], references: [id])
  guide    GuideProfile? @relation(fields: [guideId], references: [id])
  bookings Booking[]

  @@index([packageId, startsAt])
  @@index([guideId, startsAt])
}

model Booking {
  id            String        @id @default(cuid())
  cancelToken   String        @unique
  tenantId      String
  slotId        String
  customerName  String
  customerEmail String
  customerPhone String
  pax           Int
  customerCpfHash String?
  paymentId     String?
  paymentUrl    String?
  qrCode        String?
  expiresAt     DateTime?
  status         BookingStatus @default(PENDING)
  idempotencyKey String?
  createdAt      DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  slot    DepartureSlot @relation(fields: [slotId], references: [id])
  voucher Voucher?

  @@unique([tenantId, idempotencyKey])
}

model Voucher {
  id        String   @id @default(cuid())
  bookingId String   @unique
  code      String   @unique
  pdfUrl    String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum Role {
  ADMIN
  ATENDENTE
  CONDUTOR
  CLIENTE
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

enum TenantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PackageGuide {
  id        String   @id @default(cuid())
  packageId String
  guideId   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  package TourPackage  @relation(fields: [packageId], references: [id])
  guide   GuideProfile @relation(fields: [guideId], references: [id])

  @@unique([packageId, guideId])
  @@index([packageId])
  @@index([guideId])
}

model Testimonial {
  id             String       @id @default(cuid())
  text           String
  touristName    String
  rating         Int          @default(5)
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id])
  createdAt      DateTime     @default(now())
}

model ProcessedWebhookEvent {
  id          String   @id
  processedAt DateTime @default(now())
}